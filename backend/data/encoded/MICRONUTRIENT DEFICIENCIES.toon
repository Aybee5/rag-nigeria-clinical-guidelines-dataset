condition_name: Micronutrient Deficiencies
condition_slug: micronutrient-deficiencies
source: NSTG 2022
introduction: "Deficiencies of minerals (iron, iodine, zinc, calcium, phosphorus, magnesium, copper, potassium, sodium, chloride, fluoride etc); folic acid and vitamins, are prevalent globally with high rates in under-developed countries, especially sub-Saharan Africa."
clinical_features[2]:
  - type: Mineral Deficiencies
    features[5]: "Iron: anaemia","Iodine: goitre","Zinc, copper: manifestations of enzyme and insulin deficiencies","Calcium: rickets, osteomalacia","Phosphorus and fluoride: teeth and bone abnormalities"
  - type: Vitamin Deficiencies
    features[6]: "Vitamin A: keratomalacia, corneal xerosis, night blindness","Vitamin B1 (thiamine): beri-beri","Vitamin B2 (riboflavin): scrotal and vulval dermatoses, angular stomatitis, scars, Magenta tongue, cheilosis","Vitamin B3 (niacin): scarlet and dry tongue, pellagra","Vitamin C (Ascorbic acid): scurvy, petechiae and musculo-skeletal haemorrhages","Vitamin D: rickets, epiphyseal enlargement, muscle wasting, bossing of skull bone, 'thoracic rosary', persistently open anterior fontanelle, genu valgum or varum"
investigations[1]: "Blood, urine and stool tests"
treatment:
  goals[2]: Ensure adequate intake,Prevent Complications
  non_drug[2]: Food supplementation,Treat underlying diseases
  drug[1]: Administration of specific nutrients
  adverse_reactions_and_cautions[0]:
  supportive_measures[0]:
differential_diagnoses[0]:
complications[0]:
prevention[3]: Nutritional counseling,"Adequate intake of locally available, nutritious foods",Prophylactic therapies for malaria
other_investigations: null
definitive_treatment: null
prognosis: null